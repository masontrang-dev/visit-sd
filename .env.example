# Copy this to .env.local and fill in your values
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Pick any password you want for the admin panel
# This is stored in Vercel env vars, never in your code
NEXT_PUBLIC_ADMIN_PASSWORD=your-secret-password

# Comma-separated list of admin names for "Added by" dropdown (Step 2)
NEXT_PUBLIC_ADMIN_NAMES=Mason,Friend

# Google Maps API key — requires Places API + Maps JavaScript API enabled (Step 4)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
