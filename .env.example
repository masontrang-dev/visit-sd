# Copy this to .env.local and fill in your values
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only secret — NEVER expose this publicly. Required for the
# /admin/users delete-user endpoint (auth.users deletions require elevated
# privileges). Found in Supabase Dashboard > Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Maps API key (browser) — requires Places API + Maps JavaScript API enabled.
# This is exposed in the client bundle; restrict by HTTP referrer in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Google Maps API key (server-side only) — used by /api/refresh-google-data cron.
# Keep this separate from the public key so you can restrict it by IP / disable
# referrer restrictions. Falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY if unset.
GOOGLE_MAPS_SERVER_API_KEY=

# Optional: Set your site URL for OAuth redirects (defaults to window.location.origin)
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# Authentication is now managed via Supabase Auth with OAuth (Google, GitHub)
# See OAUTH_SETUP_GUIDE.md for complete setup instructions
# To configure OAuth providers, go to: Supabase Dashboard > Authentication > Providers
