# Copy this to .env.local and fill in your values
# Get these from your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Google Maps API key — requires Places API + Maps JavaScript API enabled (Step 4)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Note: User authentication is now managed via the users table in Supabase (Step 21)
# Use the seed-users.ts script to create user accounts with hashed passwords
